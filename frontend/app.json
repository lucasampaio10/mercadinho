{
  "expo": {
    "name": "PDV Mercadinho",
    "slug": "pdv-mercadinho",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "android": {
      "package": "com.pdvmercadinho.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "scheme": "pdv",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2D6A4F"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O PDV usa a câmera para ler o código de barras do produto."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2dd4c93d-9db6-4c75-8308-0df056543597"
      }
    },
    "owner": "lukasrocha0402"
  }
}
