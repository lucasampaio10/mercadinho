# URL da API backend — em desktop aponta pro localhost
# Em produção mobile real, troque pelo IP da máquina na rede local
EXPO_PUBLIC_API_URL=http://localhost:5000

# Chave compartilhada exigida pela API no header X-API-Key.
# Precisa ser idêntica ao API_KEY do backend (appsettings.Development.json).
# Gere uma nova com: openssl rand -hex 32
EXPO_PUBLIC_API_KEY=
