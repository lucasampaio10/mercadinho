# Copie este arquivo para .env e preencha os valores
# O backend lê essas variáveis automaticamente via IConfiguration

# PostgreSQL — use a string do docker-compose para desenvolvimento local
POSTGRES_CONNECTION_STRING=Host=localhost;Port=5432;Database=pdv_mercadinho;Username=postgres;Password=postgres

# Porta da API (padrão ASP.NET Core)
ASPNETCORE_URLS=http://localhost:5000

# Ambiente
ASPNETCORE_ENVIRONMENT=Development
